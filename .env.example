# Ortam değişkenleri örneği. Kopyala: cp .env.example .env  (ya da source et)
#
# CrowbarAF dış araçları PATH'ten çağırır; yolları burada değil, kurulumda ayarla.

# --- Ghidra (native/derin inceleme) ---
export GHIDRA_INSTALL_DIR="$HOME/Desktop/ghidra_12.1.4_PUBLIC"
export JAVA_HOME="/usr/lib/jvm/jdk-27-oracle-x64"

# --- Kural dizinleri ---
export CAPA_RULES="$HOME/.local/share/capa-rules"          # capa -r
export CROWBAR_YARA_RULES="$HOME/.local/share/crowbar/yara_rules"

# --- LLM (model = config) ---
export CROWBAR_LLM_PROVIDER="ollama"                        # ollama | vllm | openai
export CROWBAR_LLM_MODEL="qwen8:latest"
export CROWBAR_LLM_BASE_URL="http://localhost:11434"        # vLLM/OpenAI için değiştir
export CROWBAR_LLM_NUM_CTX="32768"
export CROWBAR_LLM_NUM_PREDICT="1200"
export CROWBAR_LLM_MAX_WORKERS="1"                          # ayni seviyede paralel istek
export CROWBAR_LLM_LOW_PRIORITY_BUDGET="400"                # dusuk oncelik: skip yerine kucuk butce
export CROWBAR_LLM_MIN_PRIORITY="0"                         # bu esigin altini hic analiz etme (1 = priority 0 decoy'lari at)
# export CROWBAR_LLM_CACHE="runs/summary_cache.json"        # memoization (opsiyonel)
# export CROWBAR_LLM_API_KEY="..."                          # openai/vllm gerekirse

# --- OpenCode Go / OpenAI-uyumlu (opsiyonel) ---
# export CROWBAR_LLM_PROVIDER="openai"
# export CROWBAR_LLM_BASE_URL="https://opencode.ai/inference/go/openai"
# export CROWBAR_LLM_MODEL="deepseek-v4.1-flash"
# export CROWBAR_LLM_API_KEY="<go-api-key>"
# export CROWBAR_LLM_USER_AGENT="crowbaraf/0.1"
# export CROWBAR_LLM_SESSION_ID="crowbaraf-run-1"

# --- Scale / büyük örnekler ---
export CROWBAR_MAX_DECOMPILE="100"                          # Ghidra top-N
export CROWBAR_FALLBACK_DECOMPILE="20"
export CROWBAR_GHIDRA_TIMEOUT="1200"                        # saniye
export CROWBAR_CAPA_TIMEOUT="600"
export CROWBAR_FLOSS_TIMEOUT="600"
export CROWBAR_READELF_TIMEOUT="60"

# --- İz (trace) çıktı dizini ---
export CROWBAR_LLM_TRACE_DIR="runs"
