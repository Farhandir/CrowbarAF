# Environment variable example. Copy: cp .env.example .env  (or source it)
#
# CrowbarAF invokes external tools from PATH; configure paths during setup, not here.

# --- Ghidra (native/deep inspection) ---
export GHIDRA_INSTALL_DIR="$HOME/Desktop/ghidra_12.1.4_PUBLIC"
export JAVA_HOME="/usr/lib/jvm/jdk-27-oracle-x64"

# --- Rules directories ---
export CAPA_RULES="$HOME/.local/share/capa-rules"          # capa -r
export CROWBAR_YARA_RULES="$HOME/.local/share/crowbar/yara_rules"

# --- Split VM / guestcontrol (optional) ---
# export CROWBAR_VM_NAME="kali-linux-2026.2-virtualbox-amd64"
# export CROWBAR_VM_USER="kali"
# export CROWBAR_VM_REPO="/home/kali/Desktop/CrowbarAF"
# export CROWBAR_VM_GHIDRA_DIR="/home/kali/Desktop/ghidra_12.1.4_PUBLIC"
# export CROWBAR_VM_CAPA_RULES="/home/kali/.local/share/capa-rules"
# export CROWBAR_VM_YARA_RULES="/home/kali/.local/share/crowbar/yara_rules"

# --- LLM (model = config) ---
export CROWBAR_LLM_PROVIDER="ollama"                        # ollama | vllm | openai
export CROWBAR_LLM_MODEL="qwen8:latest"
export CROWBAR_LLM_BASE_URL="http://localhost:11434"        # change for vLLM/OpenAI
export CROWBAR_LLM_NUM_CTX="32768"
export CROWBAR_LLM_NUM_PREDICT="1200"
export CROWBAR_LLM_MAX_WORKERS="1"                          # parallel requests at the same level
export CROWBAR_LLM_MAX_RETRIES="5"                          # retries on HTTP 429/502/503/504 and connection errors (Retry-After or backoff)
export CROWBAR_LLM_LOW_PRIORITY_BUDGET="400"                # low priority: small budget instead of skipping
export CROWBAR_LLM_MIN_PRIORITY="0"                         # do not analyze anything below this threshold (1 = skip priority 0 decoys)
# export CROWBAR_LLM_MIN_BEHAVIORS="3"                     # Policy C v2: canonical behavior classes
# export CROWBAR_LLM_MIN_ANALYZED="20"                     # LLM-only malicious needs >= this many analyzed functions
# export CROWBAR_LLM_C2_TRIAGE="1"                        # advisory C2 candidate triage in one call (0 = deterministic labels only)
# export CROWBAR_LLM_CACHE="runs/summary_cache.json"        # memoization (optional)
# export CROWBAR_LLM_API_KEY="..."                          # required for openai/vllm

# --- OpenCode Go / OpenAI-compatible (optional) ---
# export CROWBAR_LLM_PROVIDER="openai"
# export CROWBAR_LLM_BASE_URL="https://opencode.ai/inference/go/openai"
# export CROWBAR_LLM_MODEL="deepseek-v4.1-flash"
# export CROWBAR_LLM_API_KEY="<go-api-key>"
# export CROWBAR_LLM_USER_AGENT="crowbaraf/0.1"
# export CROWBAR_LLM_SESSION_ID="crowbaraf-run-1"

# --- Scale / large samples ---
export CROWBAR_MAX_DECOMPILE="100"                          # Ghidra top-N
export CROWBAR_FALLBACK_DECOMPILE="20"
export CROWBAR_GHIDRA_TIMEOUT="1200"                        # seconds
export CROWBAR_GHIDRA_MAXMEM="5g"                          # JVM -Xmx for Ghidra (large Go/Rust); empty = JVM default
export CROWBAR_CAPA_TIMEOUT="600"
export CROWBAR_FLOSS_TIMEOUT="600"
export CROWBAR_READELF_TIMEOUT="60"

# --- Trace output directory ---
export CROWBAR_LLM_TRACE_DIR="runs"
